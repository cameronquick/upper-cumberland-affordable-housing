      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1aatcc805l42ps109d1jn1ohdnh0].[sum:other_hud_units:qk]&quot;' value='Other Hud Housing' />
          <alias key='&quot;[federated.1aatcc805l42ps109d1jn1ohdnh0].[sum:pct_65_and_over:qk]&quot;' value='Elderly Rate' />
          <alias key='&quot;[federated.1aatcc805l42ps109d1jn1ohdnh0].[sum:pct_disability:qk]&quot;' value='Disability Rate' />
          <alias key='&quot;[federated.1aatcc805l42ps109d1jn1ohdnh0].[sum:total_202_811_units_adjusted:qk]&quot;' value='202/811 Units' />
        </aliases>
      </column>
      <column caption='Housing Supply Rate' datatype='real' name='[Calculation_0479148900564992]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 1] = &quot;Raw Count&quot; THEN [total_202_811_units_adjusted]&#13;&#10;ELSE ([total_202_811_units_adjusted] / [total_202_811_eligible_population]) * 1000&#13;&#10;END' />
      </column>
      <column caption='Estimated Target Population' datatype='real' name='[Calculation_0479148900667393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Elderly (65+)&quot; THEN [elderly_population]&#13;&#10;ELSEIF [Parameters].[Parameter 2] = &quot;Disability (18-64)&quot; THEN [working_age_disabled_population]&#13;&#10;ELSE [total_202_811_eligible_population]&#13;&#10;END' />
      </column>
      <column caption='State' datatype='string' name='[Calculation_0479148900745218]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Tennessee&quot;' />
      </column>
      <column caption='Demographic Rate Toggle' datatype='real' name='[Calculation_0479148900798467]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Parameters].[Parameter 2] = &quot;Elderly (65+)&quot; THEN [pct_65_and_over]&#13;&#10;ELSE [pct_disability]&#13;&#10;END' />
      </column>
      <column caption='Total 202/811 Units' datatype='integer' name='[Calculation_1467060168347650]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF {FIXED [county] : SUM([total_202_811_units_adjusted])} = 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Average Poverty Rate' datatype='real' name='[Calculation_1467060169105411]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MAX([p_r_cb])' />
      </column>
      <column caption='Region Supply Rate' datatype='real' name='[Calculation_1467060295655429]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_202_811_units_adjusted]) / SUM([total_202_811_eligible_population]) * 1000' />
      </column>
