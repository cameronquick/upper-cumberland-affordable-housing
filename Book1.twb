            <column caption='Total 202 811 Units Adjusted' datatype='real' name='[total_202_811_units_adjusted]' role='measure' type='quantitative' />
            <column caption='Total Population' datatype='integer' name='[total_population]' role='measure' type='quantitative' />
          </datasource-dependencies>
          <shelf-sorts>
            <shelf-sort-v2 dimension-to-sort='[federated.0jjn7lx0alkmvc1fdjn7v11kv8q7].[none:county:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.0jjn7lx0alkmvc1fdjn7v11kv8q7].[sum:Calculation_0852980083785728:qk]' shelf='rows' />
          </shelf-sorts>
          <aggregation value='true' />
        </view>
